with "../spcloud_config_client/spcloud_config_client.gpr";
with "aws";
with "gnatcoll_postgres.gpr";
project Finance_Mcp is

   for Source_Dirs use ("src/",
    "src/service",
    "src/model",
    "src/config");

   -- for Library_Options use ("-ltemplates_parser");

    for Object_Dir use "obj";
    for Exec_Dir use ".";

   package Builder is
      for Executable ("finance_mcp.adb") use "financemcp";
   end Builder;

   for Main use ("finance_mcp.adb");

end Finance_Mcp;
